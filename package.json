{
  "name": "stella",
  "version": "0.1.0",
  "private": true,
  "description": "Stella: companheira de IA para desktop que roda 100% local",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @stella/desktop",
    "build": "npm run build -w @stella/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc -p packages/core && tsc -p apps/desktop && tsc -p tests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:native": "npm run check:native -w @stella/desktop",
    "models:pull": "node scripts/models-pull.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:native",
    "personas:affinity": "node scripts/personas-affinity.mjs",
    "personas:review": "vitest run --config vitest.review.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
